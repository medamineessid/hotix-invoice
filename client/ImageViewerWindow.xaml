<Window x:Class="Hotix.InvoiceClient.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#FF151515"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header bar: file name + zoom controls -->
        <Border Grid.Row="0" Background="#FF232323" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleText"
                           Foreground="#FFE8E8E8"
                           FontSize="14"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Zoom out (magnifier with minus) -->
                    <Button x:Name="ZoomOutButton" Width="36" Height="30"
                            Click="ZoomOut_Click" Background="#FF333333" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                        <Viewbox Width="16" Height="16">
                            <Path Data="M 10.5,4 A 6.5,6.5 0 1 0 10.5,17 A 6.5,6.5 0 1 0 10.5,4 M 15.3,15.3 L 20,20 M 7.5,10.5 L 13.5,10.5"
                                  Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Viewbox>
                    </Button>
                    <TextBlock x:Name="ZoomText" Text="100%" Foreground="#FFCCCCCC"
                               FontSize="12" VerticalAlignment="Center" MinWidth="48"
                               TextAlignment="Center" />
                    <!-- Zoom in (magnifier with plus) -->
                    <Button x:Name="ZoomInButton" Width="36" Height="30"
                            Click="ZoomIn_Click" Background="#FF333333" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Margin="4,0,8,0">
                        <Viewbox Width="16" Height="16">
                            <Path Data="M 10.5,4 A 6.5,6.5 0 1 0 10.5,17 A 6.5,6.5 0 1 0 10.5,4 M 15.3,15.3 L 20,20 M 7.5,10.5 L 13.5,10.5 M 10.5,7.5 L 10.5,13.5"
                                  Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Viewbox>
                    </Button>
                    <!-- Fit to window (four corners) -->
                    <Button x:Name="FitButton" Width="36" Height="30"
                            Click="Fit_Click" Background="#FF333333" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                        <Viewbox Width="16" Height="16">
                            <Path Data="M 9,3 L 3,3 L 3,9 M 15,3 L 21,3 L 21,9 M 9,21 L 3,21 L 3,15 M 15,21 L 21,21 L 21,15"
                                  Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Viewbox>
                    </Button>
                    <!-- Close (X) -->
                    <Button x:Name="CloseButton" Width="36" Height="30"
                            Click="Close_Click" Background="#FF333333" Foreground="White"
                            BorderThickness="0" Cursor="Hand">
                        <Viewbox Width="16" Height="16">
                            <Path Data="M 6,6 L 18,18 M 18,6 L 6,18"
                                  Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Image area -->
        <Border Grid.Row="1" Background="#FF0D0D0D">
            <ScrollViewer x:Name="Scroller"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Image x:Name="Image"
                           Stretch="None"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                        </Image.RenderTransform>
                    </Image>
                    <TextBlock x:Name="StatusText"
                               Foreground="#FF888888"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="360"
                               TextAlignment="Center" />
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
