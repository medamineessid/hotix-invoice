<Window x:Class="Hotix.InvoiceClient.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#FF151515"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header bar: file name + zoom controls -->
        <Border Grid.Row="0" Background="#FF232323" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleText"
                           Foreground="#FFE8E8E8"
                           FontSize="14"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ZoomOutButton" Content="−" Width="32" Height="28"
                            Click="ZoomOut_Click" Background="#FF333333" Foreground="White"
                            BorderThickness="0" Cursor="Hand" FontSize="16" Margin="0,0,4,0" />
                    <TextBlock x:Name="ZoomText" Text="100%" Foreground="#FFCCCCCC"
                               FontSize="12" VerticalAlignment="Center" MinWidth="44"
                               TextAlignment="Center" />
                    <Button x:Name="ZoomInButton" Content="+" Width="32" Height="28"
                            Click="ZoomIn_Click" Background="#FF333333" Foreground="White"
                            BorderThickness="0" Cursor="Hand" FontSize="16" Margin="4,0,8,0" />
                    <Button x:Name="FitButton" Content="🔍" Width="32" Height="28"
                            Click="Fit_Click" Background="#FF333333" Foreground="White"
                            BorderThickness="0" Cursor="Hand" FontSize="14" Margin="0,0,8,0" />
                    <Button x:Name="CloseButton" Content="✕" Width="32" Height="28"
                            Click="Close_Click" Background="#FF333333" Foreground="White"
                            BorderThickness="0" Cursor="Hand" FontSize="14" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Image area -->
        <Border Grid.Row="1" Background="#FF0D0D0D">
            <ScrollViewer x:Name="Scroller"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Image x:Name="Image"
                           Stretch="None"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                        </Image.RenderTransform>
                    </Image>
                    <TextBlock x:Name="StatusText"
                               Foreground="#FF888888"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="360"
                               TextAlignment="Center" />
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
